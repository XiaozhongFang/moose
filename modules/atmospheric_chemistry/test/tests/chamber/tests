[Tests]
  [./aerosol_smoke]
    type = RunApp
    input = aerosol_smoke.i
    prereq = vs_F0AM_chamber_S3_box
    requirement = 'Smoke test: aerosol partitioning + wall loss module shall run to completion without error.'
  [../]
  [./vs_F0AM_chamber_S1_box]
    type = CSVDiff
    input = vs_F0AM_chamber_S1_box.i
    csvdiff = vs_F0AM_chamber_S1_box.csv
    rel_err = 1.0e-1
    abs_zero = 1.0e4
    ignore_columns = 'ONE'
    heavy = true
    requirement = 'S1: box mode shall match F0AM within 10% for chamber-relevant concentrations.'
  [../]
  [./vs_F0AM_chamber_S2_box]
    type = CSVDiff
    input = vs_F0AM_chamber_S2_box.i
    csvdiff = vs_F0AM_chamber_S2_box.csv
    rel_err = 5.0e-2
    abs_zero = 2.0e-6
    ignore_columns = 'ONE'
    heavy = true
    requirement = 'S2: box mode shall match F0AM within 5%.'
  [../]
  [./vs_F0AM_chamber_S2b_box]
    type = CSVDiff
    input = vs_F0AM_chamber_S2b_box.i
    csvdiff = vs_F0AM_chamber_S2b_box.csv
    rel_err = 5.0e-2
    abs_zero = 1.0e-2
    ignore_columns = 'ONE'
    heavy = true
    prereq = vs_F0AM_chamber_S2_box
    requirement = 'S2b restart shall match F0AM within 5%.'
  [../]
  [./vs_F0AM_chamber_S3_box]
    type = CSVDiff
    input = vs_F0AM_chamber_S3_box.i
    csvdiff = vs_F0AM_chamber_S3_box.csv
    rel_err = 1.0e-1
    abs_zero = 1.8e4
    ignore_columns = 'ONE'
    heavy = true
    requirement = 'S3: box mode shall match F0AM within 10% for chamber-relevant concentrations.'
  [../]
  [./vs_F0AM_chamber_aerosol]
    type = RunApp
    input = vs_F0AM_chamber_aerosol.i
    heavy = true
    prereq = vs_F0AM_chamber_S3_box
    requirement = 'Chamber aerosol simulation shall run with dynamic gas-particle partitioning enabled for 10 species pairs, producing OA mass and wall-loss output.'
  [../]
[]
